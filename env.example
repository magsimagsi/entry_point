# Copy to .env.local for local development. Never commit real values.

# Required. Password for the Admin tab.
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Optional. If set, the front desk also asks for this PIN. Leave empty for an open front desk.
STAFF_PIN=

# Optional. Time zone used for "today". Default is Asia/Manila.
APP_TIMEZONE=Asia/Manila

# Database. On Vercel these are added for you by the Upstash Redis integration
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN, or KV_REST_API_URL / KV_REST_API_TOKEN).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Local testing only, no database needed. Data is lost when the process stops.
# Never set this on Vercel.
# LOCAL_MEMORY_DB=1
